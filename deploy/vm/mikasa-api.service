[Unit]
Description=Mikasa authenticated API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mikasa
Group=mikasa
WorkingDirectory=/opt/mikasa
EnvironmentFile=/etc/mikasa/runtime.env
ExecStart=/opt/mikasa/.venv/bin/python -m mikasa --config /etc/mikasa/config.json serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
KillMode=control-group
UMask=0077
# Dedicated machine: preserve the same administrator environment as the CLI.

[Install]
WantedBy=multi-user.target
