# systemd EnvironmentFile syntax: assignments only; no export or shell commands.
# Install as /etc/mikasa/runtime.env, root:mikasa, mode 0640.
# Model IDs and endpoint paths must match the deployed CCH configuration.
MIKASA_GPT_MODEL=gpt-6-astra
MIKASA_GPT_BASE_URL=
MIKASA_GPT_API_KEY=
MIKASA_GPT_API_MODE=codex_responses
MIKASA_CLAUDE_MODEL=claude-opus-4-6
MIKASA_CLAUDE_BASE_URL=
MIKASA_CLAUDE_API_KEY=
MIKASA_CLAUDE_API_MODE=anthropic_messages
MIKASA_FEISHU_APP_ID=
MIKASA_FEISHU_APP_SECRET=
MIKASA_GITHUB_TOKEN=
# Required only when enabling the API or webhook later.
MIKASA_OWNER_API_TOKEN=
MIKASA_GITHUB_WEBHOOK_SECRET=
