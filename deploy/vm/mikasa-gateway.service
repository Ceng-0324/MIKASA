[Unit]
Description=Mikasa Hermes messaging Gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mikasa
Group=mikasa
WorkingDirectory=/opt/mikasa
EnvironmentFile=/etc/mikasa/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/mikasa/.venv/bin/python -m mikasa --config /etc/mikasa/config.json gateway --platform feishu --platform weixin
Restart=on-failure
RestartSec=10
TimeoutStopSec=40
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mikasa
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
